<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Robot JQ - Assistant Éducatif CE2 | Sarl Jonas Browser High-Tech</title>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&family=Quicksand:wght@300;400;500;600;700&family=Fredoka:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-cyan: #00f5ff;
            --primary-magenta: #ff00ff;
            --primary-yellow: #ffff00;
            --accent-green: #00ff88;
            --accent-orange: #ff8800;
            --accent-purple: #8800ff;
            --dark-bg: #0a0a1a;
            --dark-card: #12122a;
            --dark-surface: #1a1a3a;
            --glow-cyan: 0 0 20px rgba(0, 245, 255, 0.5), 0 0 40px rgba(0, 245, 255, 0.3);
            --glow-magenta: 0 0 20px rgba(255, 0, 255, 0.5), 0 0 40px rgba(255, 0, 255, 0.3);
            --glow-green: 0 0 20px rgba(0, 255, 136, 0.5), 0 0 40px rgba(0, 255, 136, 0.3);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Quicksand', sans-serif;
            background: var(--dark-bg);
            color: #ffffff;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* Animated Background */
        .bg-animation {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            overflow: hidden;
        }

        .bg-animation::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: 
                radial-gradient(circle at 20% 80%, rgba(0, 245, 255, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(255, 0, 255, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 50% 50%, rgba(136, 0, 255, 0.05) 0%, transparent 50%);
            animation: bgRotate 30s linear infinite;
        }

        @keyframes bgRotate {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .floating-particles {
            position: absolute;
            width: 100%;
            height: 100%;
        }

        .particle {
            position: absolute;
            width: 4px;
            height: 4px;
            background: var(--primary-cyan);
            border-radius: 50%;
            animation: float 15s infinite ease-in-out;
            box-shadow: var(--glow-cyan);
        }

        .particle:nth-child(2n) { background: var(--primary-magenta); box-shadow: var(--glow-magenta); }
        .particle:nth-child(3n) { background: var(--accent-green); box-shadow: var(--glow-green); }
        .particle:nth-child(1) { left: 10%; animation-delay: 0s; animation-duration: 12s; }
        .particle:nth-child(2) { left: 20%; animation-delay: 2s; animation-duration: 14s; }
        .particle:nth-child(3) { left: 30%; animation-delay: 4s; animation-duration: 16s; }
        .particle:nth-child(4) { left: 40%; animation-delay: 1s; animation-duration: 13s; }
        .particle:nth-child(5) { left: 50%; animation-delay: 3s; animation-duration: 15s; }
        .particle:nth-child(6) { left: 60%; animation-delay: 5s; animation-duration: 11s; }
        .particle:nth-child(7) { left: 70%; animation-delay: 2.5s; animation-duration: 17s; }
        .particle:nth-child(8) { left: 80%; animation-delay: 1.5s; animation-duration: 14s; }
        .particle:nth-child(9) { left: 90%; animation-delay: 4.5s; animation-duration: 12s; }

        @keyframes float {
            0%, 100% { transform: translateY(100vh) scale(0); opacity: 0; }
            10% { opacity: 1; transform: scale(1); }
            90% { opacity: 1; }
            100% { transform: translateY(-100vh) scale(0); opacity: 0; }
        }

        /* Header */
        header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            padding: 15px 40px;
            background: linear-gradient(180deg, rgba(10, 10, 26, 0.95) 0%, rgba(10, 10, 26, 0.8) 100%);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(0, 245, 255, 0.2);
        }

        .header-content {
            max-width: 1400px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo-section {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .logo-placeholder {
            width: 60px;
            height: 60px;
            border-radius: 15px;
            background: linear-gradient(135deg, var(--primary-cyan), var(--primary-magenta));
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Orbitron', sans-serif;
            font-weight: 900;
            font-size: 24px;
            box-shadow: var(--glow-cyan);
            animation: logoPulse 3s ease-in-out infinite;
        }

        /* Remplacez .logo-placeholder par cette image: */
        /* <img src="votre-logo.png" alt="Logo JB" class="logo-img"> */
        .logo-img {
            width: 60px;
            height: 60px;
            border-radius: 15px;
            box-shadow: var(--glow-cyan);
        }

        @keyframes logoPulse {
            0%, 100% { box-shadow: var(--glow-cyan); }
            50% { box-shadow: var(--glow-magenta); }
        }

        .company-name {
            font-family: 'Orbitron', sans-serif;
        }

        .company-name h1 {
            font-size: 1.4rem;
            font-weight: 700;
            background: linear-gradient(90deg, var(--primary-cyan), var(--primary-magenta));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .company-name p {
            font-size: 0.75rem;
            color: rgba(255, 255, 255, 0.6);
            letter-spacing: 2px;
        }

        nav {
            display: flex;
            gap: 30px;
        }

        nav a {
            color: #ffffff;
            text-decoration: none;
            font-weight: 500;
            font-size: 0.95rem;
            position: relative;
            padding: 8px 0;
            transition: color 0.3s ease;
        }

        nav a::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 2px;
            background: linear-gradient(90deg, var(--primary-cyan), var(--primary-magenta));
            transition: width 0.3s ease;
        }

        nav a:hover { color: var(--primary-cyan); }
        nav a:hover::after { width: 100%; }

        /* Hero Section */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 120px 40px 80px;
            position: relative;
        }

        .hero-content {
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: center;
        }

        .hero-text h2 {
            font-family: 'Fredoka', sans-serif;
            font-size: 4rem;
            font-weight: 700;
            line-height: 1.1;
            margin-bottom: 20px;
        }

        .hero-text h2 span {
            display: block;
        }

        .hero-text h2 span:nth-child(1) {
            color: var(--primary-cyan);
            text-shadow: var(--glow-cyan);
        }

        .hero-text h2 span:nth-child(2) {
            background: linear-gradient(90deg, var(--primary-magenta), var(--accent-orange));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero-text h2 span:nth-child(3) {
            color: var(--accent-green);
            text-shadow: var(--glow-green);
            font-size: 3rem;
        }

        .hero-text p {
            font-size: 1.3rem;
            color: rgba(255, 255, 255, 0.8);
            margin-bottom: 40px;
            line-height: 1.8;
        }

        .cta-buttons {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }

        .btn {
            padding: 18px 40px;
            border-radius: 50px;
            font-family: 'Quicksand', sans-serif;
            font-weight: 700;
            font-size: 1.1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            border: none;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary-cyan), var(--accent-green));
            color: var(--dark-bg);
            box-shadow: var(--glow-cyan);
        }

        .btn-primary:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 0 30px rgba(0, 245, 255, 0.6), 0 0 60px rgba(0, 245, 255, 0.4);
        }

        .btn-secondary {
            background: transparent;
            color: var(--primary-magenta);
            border: 2px solid var(--primary-magenta);
        }

        .btn-secondary:hover {
            background: var(--primary-magenta);
            color: var(--dark-bg);
            box-shadow: var(--glow-magenta);
            transform: translateY(-3px);
        }

        /* Robot Display */
        .robot-display {
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .robot-container {
            position: relative;
            width: 400px;
            height: 500px;
        }

        .robot-glow {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(0, 245, 255, 0.3) 0%, transparent 70%);
            border-radius: 50%;
            animation: robotGlow 4s ease-in-out infinite;
        }

        @keyframes robotGlow {
            0%, 100% { 
                transform: translate(-50%, -50%) scale(1);
                opacity: 0.5;
            }
            50% { 
                transform: translate(-50%, -50%) scale(1.2);
                opacity: 1;
            }
        }

        .robot-placeholder {
            position: relative;
            z-index: 2;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: linear-gradient(180deg, var(--dark-card) 0%, var(--dark-surface) 100%);
            border-radius: 30px;
            border: 2px solid rgba(0, 245, 255, 0.3);
            overflow: hidden;
        }

        /* Remplacez .robot-svg par votre vidéo/image: */
        /* <video src="robot_jq.mp4" autoplay loop muted class="robot-video"></video> */
        /* ou <img src="robot_jq.png" alt="Robot JQ" class="robot-img"> */
        .robot-video, .robot-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 28px;
        }

        .robot-svg {
            width: 250px;
            height: 300px;
            animation: robotFloat 4s ease-in-out infinite;
        }

        @keyframes robotFloat {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-20px); }
        }

        .robot-eyes {
            fill: var(--primary-cyan);
            animation: eyeBlink 3s ease-in-out infinite;
        }

        @keyframes eyeBlink {
            0%, 45%, 55%, 100% { opacity: 1; }
            50% { opacity: 0.2; }
        }

        .robot-antenna {
            animation: antennaPulse 2s ease-in-out infinite;
        }

        @keyframes antennaPulse {
            0%, 100% { fill: var(--primary-cyan); }
            50% { fill: var(--primary-magenta); }
        }

        .robot-label {
            position: absolute;
            bottom: 20px;
            font-family: 'Orbitron', sans-serif;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--primary-cyan);
            text-shadow: var(--glow-cyan);
        }

        /* Features Section */
        .features {
            padding: 100px 40px;
            background: linear-gradient(180deg, transparent 0%, rgba(0, 245, 255, 0.02) 50%, transparent 100%);
        }

        .section-title {
            text-align: center;
            margin-bottom: 60px;
        }

        .section-title h3 {
            font-family: 'Fredoka', sans-serif;
            font-size: 3rem;
            font-weight: 600;
            margin-bottom: 15px;
            background: linear-gradient(90deg, var(--primary-cyan), var(--primary-magenta), var(--accent-orange));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .section-title p {
            color: rgba(255, 255, 255, 0.6);
            font-size: 1.2rem;
        }

        .features-grid {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
        }

        .feature-card {
            background: linear-gradient(135deg, var(--dark-card) 0%, var(--dark-surface) 100%);
            border-radius: 25px;
            padding: 40px 30px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
        }

        .feature-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--primary-cyan), var(--primary-magenta));
            transform: scaleX(0);
            transition: transform 0.4s ease;
        }

        .feature-card:hover {
            transform: translateY(-10px);
            border-color: rgba(0, 245, 255, 0.3);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
        }

        .feature-card:hover::before {
            transform: scaleX(1);
        }

        .feature-icon {
            width: 70px;
            height: 70px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin-bottom: 25px;
            position: relative;
        }

        .feature-card:nth-child(1) .feature-icon {
            background: linear-gradient(135deg, rgba(0, 245, 255, 0.2), rgba(0, 245, 255, 0.05));
            color: var(--primary-cyan);
        }

        .feature-card:nth-child(2) .feature-icon {
            background: linear-gradient(135deg, rgba(255, 0, 255, 0.2), rgba(255, 0, 255, 0.05));
            color: var(--primary-magenta);
        }

        .feature-card:nth-child(3) .feature-icon {
            background: linear-gradient(135deg, rgba(0, 255, 136, 0.2), rgba(0, 255, 136, 0.05));
            color: var(--accent-green);
        }

        .feature-card:nth-child(4) .feature-icon {
            background: linear-gradient(135deg, rgba(255, 136, 0, 0.2), rgba(255, 136, 0, 0.05));
            color: var(--accent-orange);
        }

        .feature-card:nth-child(5) .feature-icon {
            background: linear-gradient(135deg, rgba(136, 0, 255, 0.2), rgba(136, 0, 255, 0.05));
            color: var(--accent-purple);
        }

        .feature-card:nth-child(6) .feature-icon {
            background: linear-gradient(135deg, rgba(255, 255, 0, 0.2), rgba(255, 255, 0, 0.05));
            color: var(--primary-yellow);
        }

        .feature-card h4 {
            font-family: 'Fredoka', sans-serif;
            font-size: 1.4rem;
            font-weight: 600;
            margin-bottom: 15px;
            color: #ffffff;
        }

        .feature-card p {
            color: rgba(255, 255, 255, 0.7);
            line-height: 1.7;
            font-size: 1rem;
        }

        /* Exercises Section */
        .exercises {
            padding: 100px 40px;
        }

        .exercises-container {
            max-width: 1000px;
            margin: 0 auto;
        }

        .exercise-tabs {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-bottom: 40px;
            flex-wrap: wrap;
        }

        .tab-btn {
            padding: 15px 30px;
            border-radius: 50px;
            background: var(--dark-card);
            border: 2px solid rgba(255, 255, 255, 0.1);
            color: rgba(255, 255, 255, 0.7);
            font-family: 'Quicksand', sans-serif;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .tab-btn:hover {
            border-color: var(--primary-cyan);
            color: var(--primary-cyan);
        }

        .tab-btn.active {
            background: linear-gradient(135deg, var(--primary-cyan), var(--accent-green));
            color: var(--dark-bg);
            border-color: transparent;
            box-shadow: var(--glow-cyan);
        }

        .exercise-content {
            background: var(--dark-card);
            border-radius: 30px;
            padding: 50px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .exercise-panel {
            display: none;
            animation: fadeIn 0.5s ease;
        }

        .exercise-panel.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .math-problem {
            text-align: center;
            padding: 30px;
        }

        .problem-display {
            font-family: 'Orbitron', sans-serif;
            font-size: 4rem;
            font-weight: 700;
            margin-bottom: 30px;
            background: linear-gradient(90deg, var(--primary-cyan), var(--primary-magenta));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .answer-input {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 20px;
            margin-bottom: 30px;
        }

        .answer-input input {
            width: 150px;
            padding: 20px;
            border-radius: 15px;
            border: 2px solid rgba(0, 245, 255, 0.3);
            background: var(--dark-surface);
            color: #ffffff;
            font-family: 'Orbitron', sans-serif;
            font-size: 2rem;
            text-align: center;
            outline: none;
            transition: all 0.3s ease;
        }

        .answer-input input:focus {
            border-color: var(--primary-cyan);
            box-shadow: var(--glow-cyan);
        }

        .check-btn {
            padding: 20px 40px;
            border-radius: 15px;
            background: linear-gradient(135deg, var(--accent-green), var(--primary-cyan));
            border: none;
            color: var(--dark-bg);
            font-family: 'Fredoka', sans-serif;
            font-size: 1.2rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .check-btn:hover {
            transform: scale(1.05);
            box-shadow: var(--glow-green);
        }

        .feedback {
            font-family: 'Fredoka', sans-serif;
            font-size: 1.5rem;
            padding: 20px;
            border-radius: 15px;
            margin-top: 20px;
        }

        .feedback.correct {
            background: rgba(0, 255, 136, 0.2);
            color: var(--accent-green);
            border: 2px solid var(--accent-green);
        }

        .feedback.incorrect {
            background: rgba(255, 0, 100, 0.2);
            color: #ff6464;
            border: 2px solid #ff6464;
        }

        .score-display {
            display: flex;
            justify-content: center;
            gap: 40px;
            margin-top: 30px;
        }

        .score-item {
            text-align: center;
        }

        .score-item .value {
            font-family: 'Orbitron', sans-serif;
            font-size: 2.5rem;
            font-weight: 700;
        }

        .score-item:nth-child(1) .value { color: var(--accent-green); }
        .score-item:nth-child(2) .value { color: #ff6464; }
        .score-item:nth-child(3) .value { color: var(--primary-cyan); }

        .score-item .label {
            color: rgba(255, 255, 255, 0.6);
            font-size: 0.9rem;
            margin-top: 5px;
        }

        /* Contact Section */
        .contact {
            padding: 100px 40px;
            background: linear-gradient(180deg, transparent 0%, rgba(255, 0, 255, 0.02) 50%, transparent 100%);
        }

        .contact-container {
            max-width: 800px;
            margin: 0 auto;
        }

        .contact-info {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 30px;
            margin-bottom: 50px;
        }

        .contact-card {
            background: var(--dark-card);
            border-radius: 20px;
            padding: 30px;
            text-align: center;
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }

        .contact-card:hover {
            border-color: var(--primary-magenta);
            transform: translateY(-5px);
        }

        .contact-card .icon {
            font-size: 2.5rem;
            margin-bottom: 15px;
        }

        .contact-card h5 {
            font-family: 'Fredoka', sans-serif;
            font-size: 1.2rem;
            margin-bottom: 10px;
            color: var(--primary-cyan);
        }

        .contact-card p {
            color: rgba(255, 255, 255, 0.7);
        }

        .contact-form {
            background: var(--dark-card);
            border-radius: 30px;
            padding: 50px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .form-group {
            margin-bottom: 25px;
        }

        .form-group label {
            display: block;
            margin-bottom: 10px;
            color: rgba(255, 255, 255, 0.8);
            font-weight: 500;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 18px 25px;
            border-radius: 15px;
            border: 2px solid rgba(255, 255, 255, 0.1);
            background: var(--dark-surface);
            color: #ffffff;
            font-family: 'Quicksand', sans-serif;
            font-size: 1rem;
            outline: none;
            transition: all 0.3s ease;
        }

        .form-group input:focus,
        .form-group textarea:focus {
            border-color: var(--primary-magenta);
            box-shadow: var(--glow-magenta);
        }

        .form-group textarea {
            min-height: 150px;
            resize: vertical;
        }

        .submit-btn {
            width: 100%;
            padding: 20px;
            border-radius: 15px;
            background: linear-gradient(135deg, var(--primary-magenta), var(--accent-purple));
            border: none;
            color: #ffffff;
            font-family: 'Fredoka', sans-serif;
            font-size: 1.3rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .submit-btn:hover {
            transform: translateY(-3px);
            box-shadow: var(--glow-magenta);
        }

        /* Footer */
        footer {
            padding: 50px 40px;
            background: var(--dark-card);
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .footer-content {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 30px;
        }

        .footer-logo {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .footer-logo .logo-placeholder {
            width: 50px;
            height: 50px;
