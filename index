    <script>
        // Tab Navigation
        const tabBtns = document.querySelectorAll('.tab-btn');
        const panels = document.querySelectorAll('.exercise-panel');

        tabBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                const tabId = btn.dataset.tab;
                
                tabBtns.forEach(b => b.classList.remove('active'));
                panels.forEach(p => p.classList.remove('active'));
                
                btn.classList.add('active');
                document.getElementById(`${tabId}-panel`).classList.add('active');
            });
        });

        // Score tracking
        const scores = {
            addition: { correct: 0, wrong: 0, streak: 0 },
            soustraction: { correct: 0, wrong: 0, streak: 0 },
            multiplication: { correct: 0, wrong: 0, streak: 0 },
            probleme: { correct: 0, wrong: 0, streak: 0 }
        };

        // Problem generators
        const problems = {
            addition: () => {
                const a = Math.floor(Math.random() * 50) + 10;
                const b = Math.floor(Math.random() * 50) + 1;
                return { display: `${a} + ${b} = ?`, answer: a + b };
            },
            soustraction: () => {
                const a = Math.floor(Math.random() * 50) + 20;
                const b = Math.floor(Math.random() * 20) + 1;
                return { display: `${a} - ${b} = ?`, answer: a - b };
            },
            multiplication: () => {
                const a = Math.floor(Math.random() * 10) + 1;
                const b = Math.floor(Math.random() * 10) + 1;
                return { display: `${a} × ${b} = ?`, answer: a * b };
            },
            probleme: () => {
                const problemTypes = [
                    () => {
                        const total = Math.floor(Math.random() * 30) + 10;
                        const given = Math.floor(Math.random() * (total - 5)) + 1;
                        return {
                            text: `🍎 Marie a <strong style="color: var(--primary-cyan);">${total} pommes</strong>. Elle en donne <strong style="color: var(--primary-magenta);">${given}</strong> à son ami. Combien de pommes lui reste-t-il ?`,
                            display: `${total} - ${given} = ?`,
                            answer: total - given
                        };
                    },
                    () => {
                        const boxes = Math.floor(Math.random() * 8) + 2;
                        const perBox = Math.floor(Math.random() * 10) + 2;
                        return {
                            text: `📦 Lucas a <strong style="color: var(--primary-cyan);">${boxes} boîtes</strong>. Chaque boîte contient <strong style="color: var(--primary-magenta);">${perBox} bonbons</strong>. Combien de bonbons a-t-il en tout ?`,
                            display: `${boxes} × ${perBox} = ?`,
                            answer: boxes * perBox
                        };
                    },
                    () => {
                        const had = Math.floor(Math.random() * 30) + 10;
                        const received = Math.floor(Math.random() * 20) + 5;
                        return {
                            text: `🎈 Emma avait <strong style="color: var(--primary-cyan);">${had} ballons</strong>. Son papa lui en donne <strong style="color: var(--primary-magenta);">${received} de plus</strong>. Combien de ballons a-t-elle maintenant ?`,
                            display: `${had} + ${received} = ?`,
                            answer: had + received
                        };
                    }
                ];
                return problemTypes[Math.floor(Math.random() * problemTypes.length)]();
            }
        };

        let currentAnswers = {
            addition: 20,
            soustraction: 18,
            multiplication: 42,
            probleme: 9
        };

        function checkAnswer(type, expectedAnswer) {
            const input = document.getElementById(`${type}-answer`);
            const feedback = document.getElementById(`${type}-feedback`);
            const userAnswer = parseInt(input.value);
            const correctAnswer = currentAnswers[type];

            if (isNaN(userAnswer)) {
                feedback.textContent = "🤔 Entre un nombre s'il te plaît !";
                feedback.className = 'feedback incorrect';
                feedback.style.display = 'block';
                return;
            }

            if (userAnswer === correctAnswer) {
                scores[type].correct++;
                scores[type].streak++;
                feedback.textContent = getSuccessMessage(scores[type].streak);
                feedback.className = 'feedback correct';
                
                // Generate new problem after delay
                setTimeout(() => generateNewProblem(type), 1500);
            } else {
                scores[type].wrong++;
                scores[type].streak = 0;
                feedback.textContent = `❌ Pas tout à fait ! La réponse était ${correctAnswer}. Essaie encore !`;
                feedback.className = 'feedback incorrect';
                
                setTimeout(() => generateNewProblem(type), 2500);
            }

            feedback.style.display = 'block';
            updateScoreDisplay(type);
            input.value = '';
        }

        function getSuccessMessage(streak) {
            const messages = [
                "🎉 Bravo, c'est correct !",
                "⭐ Super, continue comme ça !",
                "🚀 Excellent travail !",
                "🏆 Tu es un champion !",
                "✨ Incroyable, tu assures !",
                "🌟 Waouh, tu es trop fort(e) !"
            ];
            if (streak >= 5) return `🔥 ${streak} bonnes réponses d'affilée ! Tu es en feu !`;
            if (streak >= 3) return `💪 ${streak} de suite ! Continue !`;
            return messages[Math.floor(Math.random() * messages.length)];
        }

        function generateNewProblem(type) {
            const problem = problems[type]();
            document.getElementById(`${type}-problem`).textContent = problem.display;
            currentAnswers[type] = problem.answer;
            
            if (type === 'probleme' && problem.text) {
                const panel = document.getElementById('probleme-panel');
                const textP = panel.querySelector('p');
                textP.innerHTML = problem.text;
            }
            
            document.getElementById(`${type}-feedback`).style.display = 'none';
        }

        function updateScoreDisplay(type) {
            document.getElementById(`${type}-correct`).textContent = scores[type].correct;
            document.getElementById(`${type}-wrong`).textContent = scores[type].wrong;
            document.getElementById(`${type}-streak`).textContent = scores[type].streak;
        }

        // Enter key support
        document.querySelectorAll('.answer-input input').forEach(input => {
            input.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    const type = input.id.replace('-answer', '');
                    checkAnswer(type, currentAnswers[type]);
                }
            });
        });

        // Form submission
        function handleSubmit(e) {
            e.preventDefault();
            alert('✅ Message envoyé avec succès ! Nous vous répondrons rapidement.');
            e.target.reset();
        }

        // Smooth scroll
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });

        // Initialize first problems
        window.addEventListener('load', () => {
            generateNewProblem('addition');
            generateNewProblem('soustraction');
            generateNewProblem('multiplication');
            generateNewProblem('probleme');
        });
    </script>
